<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= deviceName %> · NewLine Monitor UI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>
  <body class="bg-body-tertiary">
    <%- include("partials/navbar") %>
    <main class="container pb-5" data-device-name="<%= deviceName %>">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h1 class="h3 mb-0"><%= deviceName %></h1>
        <span id="online-badge" class="badge text-bg-secondary" hidden></span>
      </div>
      <p class="text-body-secondary mb-3">Data below is fetched live from the device.</p>
      <div id="offline-alert" class="alert alert-danger d-none" role="alert">
        Device is unreachable — no live data available. It may be powered off or disconnected.
      </div>
      <table class="table table-striped w-auto mb-4">
        <tbody id="detail-tbody">
          <tr>
            <td colspan="2" class="text-body-secondary">Loading…</td>
          </tr>
        </tbody>
      </table>
      <div class="d-flex gap-2">
        <button id="save-config-btn" class="btn btn-primary" type="button" disabled>Save current state as config</button>
      </div>
      <p id="saved-config-note" class="text-body-secondary small mt-3 mb-0"></p>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script type="module" src="/js/device.js"></script>
  </body>
</html>