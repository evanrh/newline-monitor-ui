<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add device · NewLine Monitor UI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>
  <body class="bg-body-tertiary">
    <%- include("partials/navbar") %>
    <main class="container pb-5">
      <h1 class="h3 mb-3">Add device</h1>
      <form id="add-device-form" class="card p-4 bg-body" novalidate>
        <div class="mb-3">
          <label for="device-ip" class="form-label">IP address</label>
          <input id="device-ip" class="form-control" type="text" autocomplete="off" placeholder="192.168.1.50">
        </div>
        <div class="mb-3">
          <label for="device-mac" class="form-label">MAC address</label>
          <input id="device-mac" class="form-control" type="text" autocomplete="off" placeholder="AA:BB:CC:DD:EE:FF">
          <div class="form-text">Used to send Wake-on-LAN packets to the monitor.</div>
        </div>
        <div class="mb-4">
          <label for="device-name" class="form-label">Name</label>
          <input id="device-name" class="form-control" type="text" autocomplete="off" placeholder="Conference room 1">
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button id="test-connection-btn" class="btn btn-outline-secondary" type="button">Test connection</button>
          <button id="wake-device-btn" class="btn btn-outline-secondary" type="button">Wake device</button>
          <button id="save-device-btn" class="btn btn-primary" type="button">Save device</button>
        </div>
      </form>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script type="module" src="/js/add-device.js"></script>
  </body>
</html>