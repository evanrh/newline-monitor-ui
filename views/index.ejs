<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NewLine Monitor UI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" rel="stylesheet" integrity="sha384-qrALq7+6jBOZIQsNnT6xGkMDru64qD6uTlDra39xrt2SoXl4pO3FX6Roz/RpR/BS" crossorigin="anonymous">
    <style>
      .device-card { width: 17rem; }
    </style>
  </head>
  <body class="bg-body-tertiary">
    <%- include("partials/navbar") %>
    <main class="container pb-5">
      <div class="mb-3">
        <h1 class="h3 mb-2">Devices</h1>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <div class="btn-group" role="group" aria-label="Power controls for all devices">
            <button id="power-all-on-btn" class="btn btn-outline-success" type="button">
              <i class="fa-solid fa-power-off" aria-hidden="true"></i>
              Power all on
            </button>
            <button id="power-all-off-btn" class="btn btn-outline-danger" type="button">
              <i class="fa-solid fa-power-off" aria-hidden="true"></i>
              Power all off
            </button>
          </div>
          <button id="mute-all-btn" class="btn btn-outline-secondary" type="button">
            <i class="fa-solid fa-volume-xmark" aria-hidden="true"></i>
            Mute all
          </button>
          <button id="reload-config-btn" class="btn btn-primary" type="button">Reload from config</button>
          <button id="refresh-btn" class="btn btn-outline-secondary ms-auto" type="button" title="Refresh now" aria-label="Refresh now">
            <i id="refresh-icon" class="fa-solid fa-rotate-right" aria-hidden="true"></i>
            <span id="refresh-countdown" class="ms-1">10s</span>
          </button>
        </div>
      </div>
      <div id="device-cards" class="d-flex flex-wrap gap-3"></div>
      <p id="devices-status" class="mt-3 mb-0 text-body-secondary d-none"></p>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script type="module" src="/js/index.js"></script>
  </body>
</html>